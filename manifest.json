{
  "manifest_version": 3,
  "name": "startpage",
  "description": "A quiet, minimal new tab: clock, quotes, soft wallpapers, a command palette and a small file terminal.",
  "version": "1.1.0",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "https://wallhaven.cc/*",
    "https://w.wallhaven.cc/*",
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*",
    "https://picsum.photos/*",
    "https://fastly.picsum.photos/*"
  ]
}
